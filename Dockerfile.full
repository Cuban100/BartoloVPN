# BartoloVPN Full Stack Dockerfile
# This builds a complete image with all services

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies. gcc is needed because psutil==5.9.6 (in
# api/requirements.txt) has no prebuilt aarch64/cp311 wheel, so pip falls
# back to compiling it from source on that platform.
RUN apt-get update && apt-get install -y \
    wireguard-tools \
    openvpn \
    strongswan \
    qrencode \
    haproxy \
    curl \
    wget \
    git \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /config/wireguard /config/openvpn /config/ikev2 /data/logs

# Make scripts executable
RUN chmod +x scripts/*.sh

# Expose ports
EXPOSE 5000 51820 1194 500 4500 8081 8443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Default command
CMD ["docker-compose", "up", "-d"]

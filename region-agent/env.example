# Copy this file to .env and fill in real values before running
# `docker compose up -d`. scripts/provision-region.sh does this for you
# automatically - prefer that over filling this in by hand.

# Shared secret the central BartoloVPN dashboard must present to manage
# this region. Generate with: openssl rand -hex 32
# Do not commit this file with a real value, and do not reuse a key
# across regions.
AGENT_API_KEY=change-this-agent-key

# This VPS's public IP - embedded in every peer config's Endpoint line.
SERVER_IP=203.0.113.10

WIREGUARD_PORT=51820
WIREGUARD_SUBNET=10.13.13.0

# A hostname already pointed (DNS A record) at SERVER_IP, so Caddy can
# get a real Let's Encrypt certificate for it. If you don't own a domain,
# use a zero-setup wildcard service instead, e.g. 203-0-113-10.sslip.io
# (substitute your own SERVER_IP with dashes).
AGENT_HOSTNAME=your-region-hostname.example.com

# BartoloVPN Environment Configuration
# Copy this file to .env and modify the values

# Server Configuration
SERVER_IP=your-server-ip-here
DOMAIN=your-domain.com

# Web Interface
WEB_USERNAME=admin
WEB_PASSWORD=your-secure-password-change-this

# WireGuard Configuration
WIREGUARD_ENABLED=true
WIREGUARD_PORT=51820
WIREGUARD_PEERS=10
WIREGUARD_DNS=1.1.1.1,8.8.8.8
WIREGUARD_SUBNET=10.13.13.0
WIREGUARD_ALLOWED_IPS=0.0.0.0/0

# OpenVPN Configuration
OPENVPN_ENABLED=true
OPENVPN_PORT=1194
OPENVPN_PROTOCOL=udp
OPENVPN_CIPHER=AES-256-GCM
OPENVPN_AUTH=SHA256

# IKEv2 Configuration
IKEV2_ENABLED=true
IKEV2_PSK=your-ikev2-pre-shared-key-change-this
IKEV2_USER=vpnuser
IKEV2_PASSWORD=vpnpass-change-this

# Security Settings
ENCRYPTION_LEVEL=256
DNS_SERVERS=1.1.1.1,8.8.8.8
KILL_SWITCH_ENABLED=true
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Set to true once this is only reachable over HTTPS (e.g. behind Cloudflare
# Tunnel or your own TLS reverse proxy) - browsers drop secure cookies sent
# over plain HTTP, so leave this false for a plain LAN/HTTP deployment.
COOKIE_SECURE=false

# Logging and Monitoring
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
MONITORING_ENABLED=true
BANDWIDTH_LIMIT_MB=1000

# Network Configuration
LOCAL_IP=your-server-ip-here
LOCAL_IPV6=::1
PREVIOUS_IPS=

# Configuration Paths
WIREGUARD_CONFIG_PATH=/config/wireguard
OPENVPN_CONFIG_PATH=/config/openvpn
IKEV2_CONFIG_PATH=/config/ikev2

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/bartolovpn.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=1
API_RELOAD=true

# Docker Network Configuration
VPN_NETWORK_SUBNET=172.25.0.0/16
VPN_EXTERNAL_SUBNET=10.15.15.0/24

# Cloudflare Tunnel (Optional)
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# HAProxy Configuration
HAPROXY_ENABLED=true
HAPROXY_HTTP_PORT=8081
HAPROXY_HTTPS_PORT=8443
